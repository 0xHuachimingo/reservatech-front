<html lang="es">
  <head>
    <title>Modo Neón</title>
    <style>
      body { background: #000; color: #fff; font-family: system-ui, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
      .caja-neon {
        padding: 3rem;
        border: 2px solid #0ff;
        box-shadow: 0 0 20px #0ff, inset 0 0 20px #0ff;
        border-radius: 15px;
        text-align: center;
      }
      h1 { text-shadow: 0 0 10px #f0f, 0 0 20px #f0f; font-size: 3rem; margin: 0; }
      p { color: #0ff; letter-spacing: 3px; text-transform: uppercase; margin-top: 1rem; }
    </style>
  </head>
  <body>
    <div class="caja-neon">
      <h1>RESERVATECH</h1>
      <p>Rendimiento Máximo</p>
    </div>
  </body>
</html>